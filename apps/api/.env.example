# ---- database ----
DATABASE_URL="postgresql://todoapli:todoapli@localhost:5434/todoapli?schema=public"

# ---- auth ----
# "dev"    … 自前発行のダミー JWT（HS256）。AWS 不要。pnpm run token で発行
# それ以外 … Cognito の JWKS で検証（Phase 4 以降の既定）
AUTH_MODE="cognito"

# AUTH_MODE=dev のときだけ使う開発用の共有鍵
DEV_JWT_SECRET="dev-only-secret-do-not-use-in-production"

# ---- cognito（pnpm run env:sync で terraform の output から書き込まれる）----
COGNITO_ISSUER=""
COGNITO_CLIENT_ID=""

# ---- server ----
PORT=3000
